# ===== AI Office Agents - 환경변수 설정 =====

# ----- DeskRPG -----
DATABASE_URL=postgresql://deskrpg:deskrpg_dev_pw@localhost:5437/deskrpg
# 또는 SQLite 사용 시:
# DB_TYPE=sqlite
# SQLITE_PATH=data/deskrpg.db
JWT_SECRET=change-me-to-a-random-64-char-string
OPENCLAW_TOKEN=change-me-openclaw-token

# ----- AI 모델 API 키 -----
OPENAI_API_KEY=sk-xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx
GOOGLE_AI_API_KEY=AIzaSyxxxx

# ----- 텔레그램 -----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_USERS=your_telegram_user_id

# ----- 슬랙 -----
SLACK_BOT_TOKEN=xoxb-xxxx
SLACK_APP_TOKEN=xapp-xxxx
SLACK_REPORT_CHANNEL=C0XXXXXXX

# ----- 카카오톡 (macOS 전용) -----
KAKAO_CHAT_ROOM=AI사무실보고
KAKAO_ENABLED=false

# ----- Hermes Agent -----
HERMES_HOME=~/.hermes
HERMES_GATEWAY_PORT=8765

# ----- DeskRPG 서버 -----
DESKRPG_PORT=3000
DESKRPG_HOST=localhost
