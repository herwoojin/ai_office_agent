// =============================================================================
// AI Office Agents — Firestore Security Rules
// Project: desk-rpg-a2edb
//
// 디자인 원칙:
//  1) 인증 필수 — 익명/미인증은 모든 collection 접근 차단
//  2) 본인 소유 데이터만 읽기/쓰기 (사용자 프로필, 캐릭터, 개인 task)
//  3) 채널 멤버만 채널 내부 데이터(NPC, 메시지, 회의록) 접근
//  4) 채널 owner 만 NPC/메타데이터 수정
//  5) immutable 필드 보호 (createdAt, ownerId)
//  6) 서버측 Admin SDK 우회: rules는 클라이언트 SDK 만 막는다 (Admin SDK 는 항상 통과)
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────── 헬퍼 함수 ───────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 채널 멤버 여부: /channels/{id}/members/{uid} 에 본인 문서가 있는지
    function isChannelMember(channelId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/channels/$(channelId)/members/$(request.auth.uid));
    }

    // 채널 owner 여부: /channels/{id}.ownerId == 본인 uid
    function isChannelOwner(channelId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid;
    }

    // 시스템 관리자 여부: /users/{uid}.systemRole == "system_admin"
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == "system_admin";
    }

    // create 시 ownerId 가 본인이고, createdAt 이 server timestamp 인지
    function hasValidCreateMeta() {
      return request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    // update 시 immutable 필드 변경 금지
    function isImmutablePreserved(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }


    // ─────────────── /users/{userId} ───────────────
    // 사용자 프로필. 본인만 read/write. systemRole 은 관리자만 변경.
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.systemRole == "user"
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(userId)
        // 본인은 systemRole 변경 금지
        && isImmutablePreserved(['systemRole', 'createdAt', 'loginId'])
        || isAdmin();
      allow delete: if isAdmin();
    }


    // ─────────────── /characters/{characterId} ───────────────
    // 본인 소유 캐릭터만 read/write
    match /characters/{characterId} {
      allow read: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if hasValidCreateMeta();
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && isImmutablePreserved(['ownerId', 'createdAt']);
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }


    // ─────────────── /groups/{groupId} ───────────────
    // 그룹 (조직). 멤버는 read, owner/admin 만 write.
    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (resource.data.isDefault == true
            || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)));
      allow create: if isAdmin() || hasValidCreateMeta();
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && isImmutablePreserved(['ownerId', 'createdAt', 'slug']);
      allow delete: if isAdmin();

      // 그룹 멤버십
      match /members/{memberUid} {
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
        allow create, update, delete: if isSignedIn()
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
              || isAdmin());
      }
    }


    // ─────────────── /channels/{channelId} ───────────────
    // 채널 (가상 오피스). 공개 채널은 인증 사용자 모두 read, 비공개는 멤버만.
    match /channels/{channelId} {
      allow read: if isSignedIn()
        && (resource.data.isPublic == true
            || isChannelMember(channelId));
      allow create: if hasValidCreateMeta();
      allow update: if isChannelOwner(channelId)
        && isImmutablePreserved(['ownerId', 'createdAt', 'groupId']);
      allow delete: if isChannelOwner(channelId) || isAdmin();


      // 채널 멤버 sub-collection
      match /members/{memberUid} {
        allow read: if isChannelMember(channelId);
        // 본인이 join 또는 owner 가 추가
        allow create: if isSelf(memberUid) || isChannelOwner(channelId);
        allow update: if isChannelOwner(channelId);
        allow delete: if isSelf(memberUid) || isChannelOwner(channelId);
      }


      // ─── NPC (AI 에이전트) ───
      // 모든 멤버 read, owner 만 create/update/delete.
      match /npcs/{npcId} {
        allow read: if isChannelMember(channelId);
        allow create, update, delete: if isChannelOwner(channelId);

        // NPC openclawConfig (LLM 모델, 페르소나 등 민감 정보)
        // owner 만 read 가능 — 채팅 시에는 서버 Admin SDK 가 처리
        match /config/{configId} {
          allow read, write: if isChannelOwner(channelId);
        }
      }


      // ─── 채팅 메시지 ───
      // 멤버 read, 작성자 본인만 create/delete, update 는 금지(편집 불가)
      match /messages/{messageId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelMember(channelId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
        allow update: if false; // 편집 금지
      }


      // ─── 회의록 / Meeting Minutes ───
      // 멤버 read, 작성자/owner write
      match /meetings/{meetingId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelMember(channelId)
          && request.resource.data.initiatorId == request.auth.uid;
        allow update: if isChannelMember(channelId)
          && (resource.data.initiatorId == request.auth.uid || isChannelOwner(channelId));
        allow delete: if isChannelOwner(channelId);

        // 회의 발언 turns
        match /turns/{turnId} {
          allow read: if isChannelMember(channelId);
          allow write: if isChannelMember(channelId);
        }
      }


      // ─── 태스크 (NPC 작업) ───
      match /tasks/{taskId} {
        allow read: if isChannelMember(channelId);
        allow create: if isChannelMember(channelId);
        allow update: if isChannelMember(channelId)
          && isImmutablePreserved(['createdAt', 'assignerId']);
        allow delete: if isChannelMember(channelId)
          && (resource.data.assignerId == request.auth.uid || isChannelOwner(channelId));
      }


      // ─── 보고서 ───
      match /reports/{reportId} {
        allow read: if isChannelMember(channelId);
        allow create, update: if isChannelMember(channelId);
        allow delete: if isChannelOwner(channelId);
      }
    }


    // ─────────────── /maps/{mapId} ───────────────
    // 맵 템플릿. 공개 템플릿은 모든 사용자 read. write 는 admin 만.
    match /maps/{mapId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ─────────────── /gateways/{gatewayId} ───────────────
    // OpenClaw 게이트웨이 자원. 소유자만 read/write (토큰 포함이므로 보호 강화).
    match /gateways/{gatewayId} {
      allow read, write: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if hasValidCreateMeta();
    }


    // ─────────────── /system/{docId} ───────────────
    // 시스템 설정 / 공지. 모두 read, admin 만 write.
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }


    // ─────────────── 기본 deny ───────────────
    // 위에 명시되지 않은 모든 경로 거부 (보안 기본값)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
